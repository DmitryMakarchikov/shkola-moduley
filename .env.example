# настройки сервера: скопируйте этот файл в .env и заполните нужное

# порт сайта
PORT=3000

# база данных PostgreSQL на сервере; если не указать — встроенная база в папке apps/server/data
# DATABASE_URL=postgres://user:password@localhost:5432/shkola

# бот Telegram: токен от @BotFather — уведомления о работах и отметках
# TELEGRAM_BOT_TOKEN=123456:ABC...
# адрес сайта для ссылок в сообщениях бота
# PUBLIC_URL=https://shkola.example.by

# куки только по HTTPS (включить на сервере с сертификатом)
# COOKIE_SECURE=1

# демонстрационные данные при первом запуске (0 — не создавать)
# SEED_DEMO=1
